                  onClick={() => onViewCourse(course)}
                  className="mt-4 w-full py-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-semibold rounded-xl text-sm transition-all flex items-center justify-center gap-2"
