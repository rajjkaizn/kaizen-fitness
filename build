import React, { createContext, useContext, useState, useEffect } from 'react';

const AuthContext = createContext(null);

const ALL_COURSE_IDS = [
  'course-bundle-all',
  'course-build',
  'course-cut',
  'course-gain',
  'course-powerlifting',
];

const DEFAULT_DEMO_USER = {
  id: 'usr-101',
  name: 'Alex Mercer',
  email: 'alex.mercer@kaizen.fit',
  role: 'student',
  avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80',
  currentStreak: 14,
  enrolledCourseIds: ['course-build'], // Demo user starts with Build track enrolled
  completedLessonIds: ['les-b1-1'],
  quizScores: {},
  joinedDate: 'August 2026'
};

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(() => {
    try {
      const saved = localStorage.getItem('kaizen_auth_user');
      if (saved) {
        const parsed = JSON.parse(saved);
        // Clear any old hardcoded session where all courses were forcefully enrolled
        if (parsed.email === 'alex.mercer@kaizen.fit' && parsed.enrolledCourseIds?.length > 2) {
          localStorage.removeItem('kaizen_auth_user');
          return null;
        }
        return parsed;
      }
      return null; // Public visitors start as unauthenticated guests!
    } catch (e) {
      return null;
    }
  });

  const [authModalOpen, setAuthModalOpen] = useState(false);
  const [authMode, setAuthMode] = useState('login'); // 'login' or 'signup'
  const [pendingCourseEnroll, setPendingCourseEnroll] = useState(null);

  useEffect(() => {
    if (user) {
      localStorage.setItem('kaizen_auth_user', JSON.stringify(user));
    } else {
      localStorage.removeItem('kaizen_auth_user');
    }
  }, [user]);

  const login = (email, password) => {
    // If demo login requested
    if (email === 'alex.mercer@kaizen.fit') {
      setUser(DEFAULT_DEMO_USER);
      setAuthModalOpen(false);
      return { success: true };
    }
    const loggedUser = {
      id: 'usr-' + Date.now(),
      email: email || 'athlete@kaizen.fit',
      name: email ? email.split('@')[0] : 'Athlete',
      role: 'student',
      avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80',
      currentStreak: 1,
      enrolledCourseIds: [],
      completedLessonIds: [],
      quizScores: {},
      joinedDate: 'November 2026'
    };
    setUser(loggedUser);
    setAuthModalOpen(false);
    return { success: true };
  };

  const signup = (name, email, password) => {
    const newUser = {
      id: 'usr-' + Date.now(),
      name: name || 'New Athlete',
      email: email,
      role: 'student',
      avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80',
      currentStreak: 1,
      enrolledCourseIds: [],
      completedLessonIds: [],
      quizScores: {},
      joinedDate: 'November 2026'
    };
    setUser(newUser);
    setAuthModalOpen(false);
    return { success: true };
  };

  const logout = () => {
    setUser(null);
  };

  const isEnrolled = (courseId) => {
    if (!user) return false;
    if (user.enrolledCourseIds?.includes('course-bundle-all')) return true;
    return user.enrolledCourseIds?.includes(courseId);
  };

  const enrollInCourse = (courseId) => {
    const toEnroll = courseId === 'course-bundle-all'
      ? ['course-bundle-all', 'course-build', 'course-cut', 'course-gain', 'course-powerlifting']
      : [courseId];

    setUser(prev => {
      if (!prev) {
        return {
          id: 'usr-' + Date.now(),
          name: 'Kaizen Athlete',
          email: 'athlete@kaizen.fit',
          role: 'student',
          avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80',
          currentStreak: 1,
          enrolledCourseIds: toEnroll,
          completedLessonIds: [],
          quizScores: {},
          joinedDate: 'November 2026'
        };
      }
      return {
        ...prev,
        enrolledCourseIds: Array.from(new Set([...(prev.enrolledCourseIds || []), ...toEnroll]))
      };
    });
    return true;
  };

  const toggleLessonCompletion = (lessonId) => {
    if (!user) return;
    setUser(prev => {
      const alreadyCompleted = prev.completedLessonIds.includes(lessonId);
      const updated = alreadyCompleted
        ? prev.completedLessonIds.filter(id => id !== lessonId)
        : [...prev.completedLessonIds, lessonId];
      return { ...prev, completedLessonIds: updated };
    });
  };

  const isLessonCompleted = (lessonId) => {
    if (!user) return false;
    return user.completedLessonIds?.includes(lessonId);
  };

  const recordQuizResult = (courseId, score, passed) => {
    if (!user) return;
    setUser(prev => ({
      ...prev,
      quizScores: {
        ...prev.quizScores,
        [courseId]: { score, passed, date: new Date().toISOString() }
      }
    }));
  };

  const openAuth = (mode = 'login', pendingCourse = null) => {
    setAuthMode(mode);
    setPendingCourseEnroll(pendingCourse);
    setAuthModalOpen(true);
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        login,
        signup,
        logout,
        isEnrolled,
        enrollInCourse,
        toggleLessonCompletion,
        isLessonCompleted,
        recordQuizResult,
        authModalOpen,
        setAuthModalOpen,
        authMode,
        setAuthMode,
        openAuth,
        pendingCourseEnroll,
        setPendingCourseEnroll
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => useContext(AuthContext);

import React, { createContext, useContext, useState, useEffect } from 'react';
import { WORKOUT_TEMPLATES, INITIAL_PROGRESS_LOGS } from '../data/sampleWorkouts';

const WorkoutContext = createContext(null);

export const WorkoutProvider = ({ children }) => {
  const [selectedTrack, setSelectedTrack] = useState('build');
  const [activeWorkout, setActiveWorkout] = useState(null);
  
  const [progressLogs, setProgressLogs] = useState(() => {
    try {
      const saved = localStorage.getItem('kaizen_progress_logs');
      return saved ? JSON.parse(saved) : INITIAL_PROGRESS_LOGS;
    } catch (e) {
      return INITIAL_PROGRESS_LOGS;
    }
  });

  const [completedWorkouts, setCompletedWorkouts] = useState(() => {
    try {
      const saved = localStorage.getItem('kaizen_completed_workouts');
      return saved ? JSON.parse(saved) : [
        {
          id: 'cw-1',
          date: '2026-08-15',
          workoutName: 'Day 1: Upper Hypertrophy',
          trackId: 'build',
          durationMinutes: 58,
          exercisesLogged: 5,
          totalVolumeKg: 4280
        }
      ];
    } catch (e) {
      return [];
    }
  });

  useEffect(() => {
    localStorage.setItem('kaizen_progress_logs', JSON.stringify(progressLogs));
  }, [progressLogs]);

  useEffect(() => {
    localStorage.setItem('kaizen_completed_workouts', JSON.stringify(completedWorkouts));
  }, [completedWorkouts]);

  const addBodyweightEntry = (entry) => {
    const newEntry = {
      date: entry.date || new Date().toISOString().split('T')[0],
      weight: parseFloat(entry.weight),
      bodyFat: entry.bodyFat ? parseFloat(entry.bodyFat) : null,
      track: selectedTrack,
      notes: entry.notes || ''
    };
    setProgressLogs(prev => [newEntry, ...prev]);
  };

  const saveCompletedWorkout = (workoutData) => {
    const newRecord = {
      id: 'cw-' + Date.now(),
      date: new Date().toISOString().split('T')[0],
      ...workoutData
    };
    setCompletedWorkouts(prev => [newRecord, ...prev]);
  };

  // Epley and Brzycki 1RM Estimation
  const calculate1RM = (weight, reps) => {
    if (!weight || !reps || reps <= 0) return { epley: 0, brzycki: 0, rounded: 0 };
    const w = parseFloat(weight);
    const r = parseInt(reps, 10);
    if (r === 1) return { epley: w, brzycki: w, rounded: Math.round(w) };

    const epley = w * (1 + r / 30);
    const brzycki = w * (36 / (37 - r));
    const avg = (epley + brzycki) / 2;

    return {
      epley: Math.round(epley * 10) / 10,
      brzycki: Math.round(brzycki * 10) / 10,
      rounded: Math.round(avg)
    };
  };

  return (
    <WorkoutContext.Provider
      value={{
        selectedTrack,
        setSelectedTrack,
        workoutTemplates: WORKOUT_TEMPLATES,
        progressLogs,
        addBodyweightEntry,
        completedWorkouts,
        saveCompletedWorkout,
        calculate1RM,
        activeWorkout,
        setActiveWorkout
      }}
    >
      {children}
    </WorkoutContext.Provider>
  );
};

export const useWorkout = () => useContext(WorkoutContext);

