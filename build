                    <span className="flex items-center gap-1"><Shield className="w-3.5 h-3.5 text-emerald-400" />30-day refund</span>
                    <span className="flex items-center gap-1"><Award className="w-3.5 h-3.5 text-amber-400" />Official Certificate</span>
