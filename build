const STORAGE_KEY = 'kaizen_checklist';

export const WeeklyChecklist = ({ selectedTrackId }) => {
  const [trackId, setTrackId] = useState(selectedTrackId || 'build');
  const [checked, setChecked] = useState(() => {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
  });

  useEffect(() => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(checked));
  }, [checked]);

  const color = TRACK_COLORS[trackId] || TRACK_COLORS.build;
  const items = WEEKLY_CHECKLIST_ITEMS[trackId] || [];

  const toggle = (id) => setChecked(prev => ({ ...prev, [id]: !prev[id] }));
  const resetTrack = () => {
    const reset = { ...checked };
    items.forEach(item => { delete reset[item.id]; });
    setChecked(reset);
  };

  const totalChecked = items.filter(i => checked[i.id]).length;
  const pct = items.length > 0 ? Math.round((totalChecked / items.length) * 100) : 0;

  // Group by category
  const grouped = items.reduce((acc, item) => {
    if (!acc[item.category]) acc[item.category] = [];
    acc[item.category].push(item);
    return acc;
  }, {});

  return (
    <div className="max-w-3xl mx-auto px-4 py-10">
      <div className="mb-6">
        <h1 className="text-3xl font-black text-white font-display">✅ Weekly Checklist</h1>
        <p className="text-slate-400 text-sm mt-1">Track your weekly habits across workouts, nutrition, recovery, progress, and course content.</p>
      </div>

      {/* Track Selector */}
      <div className="flex flex-wrap gap-2 mb-6">
        {TRACKS.map(t => {
          const Icon = TRACK_ICONS[t.id];
          const c = TRACK_COLORS[t.id];
          return (
            <button key={t.id} onClick={() => setTrackId(t.id)}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold uppercase border transition-all ${
                trackId === t.id ? `${c.bg} ${c.label} ${c.border}` : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-white'
              }`}>
              <Icon className="w-3.5 h-3.5" />{t.id}
            </button>
          );
        })}
      </div>

      {/* Progress Ring */}
      <div className={`p-5 rounded-2xl ${color.bg} border ${color.border} mb-6 flex items-center gap-5`}>
        <div className="relative w-20 h-20 flex-shrink-0">
          <svg className="w-full h-full -rotate-90" viewBox="0 0 36 36">
            <circle cx="18" cy="18" r="15.915" fill="none" stroke="#1e293b" strokeWidth="3" />
            <circle cx="18" cy="18" r="15.915" fill="none" strokeWidth="3"
              className={color.label.replace('text-', 'stroke-')}
              strokeDasharray={`${pct} ${100 - pct}`}
              strokeLinecap="round" />
          </svg>
          <div className="absolute inset-0 flex items-center justify-center">
            <span className={`text-lg font-black ${color.label}`}>{pct}%</span>
          </div>
        </div>
        <div className="flex-1">
          <div className="text-white font-bold text-base">{totalChecked} / {items.length} items completed</div>
          <div className="text-sm text-slate-400 mt-0.5">
            {pct === 100 ? '🎉 Perfect week! Incredible consistency.' :
             pct >= 80 ? '🔥 Great week! Nearly perfect.' :
             pct >= 50 ? '💪 Solid progress. Finish strong!' :
             'Get started — tick off your habits one by one.'}
          </div>
        </div>
        <button onClick={resetTrack} className="flex items-center gap-1.5 px-3 py-2 bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-xl text-xs text-slate-400 hover:text-white transition-all">
          <RefreshCw className="w-3.5 h-3.5" /> Reset Week
        </button>
      </div>

      {/* Checklist by category */}
      <div className="space-y-4">
        {Object.entries(grouped).map(([category, catItems]) => {
          const catChecked = catItems.filter(i => checked[i.id]).length;
          return (
            <div key={category} className="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
              <div className="px-4 py-2.5 border-b border-slate-800 flex items-center justify-between bg-slate-950/50">
                <span className="text-xs font-bold text-white">{category}</span>
                <span className="text-[11px] text-slate-400">{catChecked}/{catItems.length}</span>
              </div>
              <div className="divide-y divide-slate-800/50">
                {catItems.map(item => {
                  const isChecked = !!checked[item.id];
                  return (
                    <button
                      key={item.id}
                      onClick={() => toggle(item.id)}
                      className={`w-full flex items-center gap-3 px-4 py-3 text-left transition-all ${
                        isChecked ? 'bg-emerald-500/5' : 'hover:bg-slate-800/30'
                      }`}
                    >
                      {isChecked
                        ? <CheckSquare className={`w-5 h-5 flex-shrink-0 ${color.check}`} />
                        : <Square className="w-5 h-5 flex-shrink-0 text-slate-600" />
                      }
                      <span className={`text-sm transition-colors ${isChecked ? 'text-slate-400 line-through' : 'text-slate-200'}`}>
                        {item.label}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

