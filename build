          { week: 10, focus: 'Heavy Doubles', days: ['Squat: 3×2 @ 90%', 'Bench: 3×2 @ 90%', 'Deadlift: 2×2 @ 92%', 'No accessories — full CNS reserve for main lifts only.'], rpe: '9', notes: 'Doubles at 90% feel like singles. This is the goal.' },
        ]
      },
      {
        phase: 'Phase 3: Peak & Test (Weeks 13–16)',
