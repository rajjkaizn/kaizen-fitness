import React from 'react';
import {
  CheckCircle,
  AlertTriangle,
  Flame,
  Award,
  BookOpen,
  ArrowRight,
  Sparkles,
  ClipboardCheck,
  Zap,
} from 'lucide-react';

/**
 * Custom Markdown & Structure Renderer for Kaizen Fitness Academy Lessons
 * Converts structured lesson content into an interactive, beautifully styled editorial layout.
 */
export const LessonContentRenderer = ({ content, lesson, color = 'emerald' }) => {
  // If content is missing, dynamically build a comprehensive lesson guide from lesson metadata
  const effectiveContent = content || (lesson ? `## ${lesson.title || 'Lesson Overview'}

### Lesson Overview
${lesson.summary || 'Welcome to this in-depth educational chapter from the Kaizen Fitness Academy curriculum. Follow the structured protocols below to master these training concepts.'}

### Core Principles & Takeaways
${lesson.keyTakeaways?.map(t => `- ${t}`).join('\n') || '- Master exercise biomechanics and control tempo on every repetition.\n- Record all sets, loads, and RIR in the Kaizen Workout Log.\n- Prioritize 7.5 to 9 hours of sleep and adequate protein intake.'}

### Step-by-Step Implementation Protocol
1. **Warm-Up:** Perform 5–10 minutes of general cardiovascular warm-up followed by exercise-specific ramp-up sets.
2. **Execution:** Execute all prescribed working sets with strict technical form, stopping 1–2 reps before muscular failure.
3. **Tracking:** Immediately log your weights, repetitions, and perceived exertion in the Kaizen Workout Tracker.

### Common Mistakes to Avoid
- Sacrificing form for heavier weight on the barbell.
- Neglecting the eccentric (lowering) phase of the lift.
- Inconsistent training frequency or skipping planned recovery days.

### Today's Action Task
Review your blueprint parameters, execute today's target training volume, and complete the knowledge assessment quiz for this lesson.

### Completion Requirement
Read through all educational principles above and achieve at least 80% on the lesson quiz.` : null);

  if (!effectiveContent) {
    return (
      <div className="p-8 text-center text-slate-400">
        <BookOpen className="w-8 h-8 mx-auto mb-2 opacity-50" />
        <p>Loading lesson educational guide...</p>
      </div>
    );
  }

  const lines = effectiveContent.split('\n');
  const elements = [];
  let currentTable = null;
  let inCodeBlock = false;
  let codeBuffer = [];

  const flushTable = () => {
    if (currentTable && currentTable.rows.length > 0) {
      elements.push({
        type: 'table',
        headers: currentTable.headers,
        rows: currentTable.rows,
      });
      currentTable = null;
    }
  };

  const flushCode = () => {
    if (codeBuffer.length > 0) {
      elements.push({
        type: 'code',
        code: codeBuffer.join('\n'),
      });
      codeBuffer = [];
    }
  };

  for (let i = 0; i < lines.length; i++) {
    const rawLine = lines[i];
    const line = rawLine.trim();

    // Code block fences
    if (line.startsWith('```')) {
      if (inCodeBlock) {
        flushCode();
        inCodeBlock = false;
      } else {
        flushTable();
        inCodeBlock = true;
      }
      continue;
    }

    if (inCodeBlock) {
      codeBuffer.push(rawLine);
      continue;
    }

    // Markdown Table handling
    if (line.startsWith('|') && line.endsWith('|')) {
      const cells = line
        .split('|')
        .slice(1, -1)
        .map((c) => c.trim());

      // Check if it's separator line (e.g. |:---|:---|)
      if (cells.every((c) => /^:?-+:?$/.test(c))) {
        continue;
      }

      if (!currentTable) {
        currentTable = { headers: cells, rows: [] };
      } else {
        currentTable.rows.push(cells);
      }
      continue;
    } else {
      flushTable();
    }

    // Empty lines
    if (!line) {
      continue;
    }

    // Headings
    if (line.startsWith('## ')) {
      elements.push({ type: 'h2', text: line.replace('## ', '') });
    } else if (line.startsWith('### ')) {
      elements.push({ type: 'h3', text: line.replace('### ', '') });
    } else if (line.startsWith('#### ')) {
      elements.push({ type: 'h4', text: line.replace('#### ', '') });
    } else if (/^\d+\.\s/.test(line)) {
      elements.push({
        type: 'ordered-list-item',
        text: line.replace(/^\d+\.\s*/, ''),
      });
    } else if (line.startsWith('- ') || line.startsWith('* ')) {
      elements.push({
        type: 'unordered-list-item',
        text: line.replace(/^[-*]\s*/, ''),
      });
    } else {
      elements.push({ type: 'p', text: line });
    }
  }

  flushTable();
  flushCode();

  // Helper to render bold markdown (**text**)
  const renderInline = (str) => {
    if (!str) return '';
    const parts = [];
    let remaining = str;
    let key = 0;

    // Match **bold**
    while (remaining.length > 0) {
      const boldMatch = remaining.match(/\*\*(.*?)\*\*/);
      if (boldMatch && boldMatch.index !== undefined) {
        const pre = remaining.substring(0, boldMatch.index);
        if (pre) parts.push(<span key={key++}>{pre}</span>);
        parts.push(
          <strong key={key++} className="font-bold text-white">
            {boldMatch[1]}
          </strong>
        );
        remaining = remaining.substring(boldMatch.index + boldMatch[0].length);
      } else {
        parts.push(<span key={key++}>{remaining}</span>);
        break;
      }
    }
    return parts;
  };

  // Color mappings
  const colorStyles = {
    emerald: {
      accentText: 'text-emerald-400',
      accentBg: 'bg-emerald-500/10',
      accentBorder: 'border-emerald-500/30',
      badge: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
      taskBg: 'bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-950',
    },
    cyan: {
      accentText: 'text-cyan-400',
      accentBg: 'bg-cyan-500/10',
      accentBorder: 'border-cyan-500/30',
      badge: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30',
      taskBg: 'bg-gradient-to-r from-cyan-950/40 via-slate-900 to-slate-950',
    },
    amber: {
      accentText: 'text-amber-400',
      accentBg: 'bg-amber-500/10',
      accentBorder: 'border-amber-500/30',
      badge: 'bg-amber-500/20 text-amber-300 border-amber-500/30',
      taskBg: 'bg-gradient-to-r from-amber-950/40 via-slate-900 to-slate-950',
    },
    purple: {
      accentText: 'text-purple-400',
      accentBg: 'bg-purple-500/10',
      accentBorder: 'border-purple-500/30',
      badge: 'bg-purple-500/20 text-purple-300 border-purple-500/30',
      taskBg: 'bg-gradient-to-r from-purple-950/40 via-slate-900 to-slate-950',
    },
  }[color] || {
    accentText: 'text-emerald-400',
    accentBg: 'bg-emerald-500/10',
    accentBorder: 'border-emerald-500/30',
    badge: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
    taskBg: 'bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-950',
  };

  return (
    <div className="max-w-4xl mx-auto space-y-6 text-slate-300 leading-relaxed font-sans pb-16">
      {elements.map((el, idx) => {
        switch (el.type) {
          case 'h2':
            return (
              <div key={idx} className="pt-2 pb-1 border-b border-slate-800">
                <h2 className="text-2xl sm:text-3xl font-black text-white font-display tracking-tight flex items-center gap-2">
                  <Sparkles className={`w-6 h-6 ${colorStyles.accentText}`} />
                  {renderInline(el.text)}
                </h2>
              </div>
            );

          case 'h3': {
            const headingText = el.text.toLowerCase();
            const isActionTask = headingText.includes("action task");
            const isCommonMistake = headingText.includes("mistake");
            const isObjectives = headingText.includes("objective");
            const isCompletion = headingText.includes("completion");
            const isScience = headingText.includes("scientific");

            return (
              <div
                key={idx}
                className={`pt-6 pb-2 flex items-center gap-2.5 font-bold text-lg text-white font-display ${
                  isActionTask
                    ? 'text-amber-400'
                    : isCommonMistake
                    ? 'text-rose-400'
                    : isScience
                    ? colorStyles.accentText
                    : ''
                }`}
              >
                {isActionTask && <ClipboardCheck className="w-5 h-5 text-amber-400" />}
                {isCommonMistake && <AlertTriangle className="w-5 h-5 text-rose-400" />}
                {isObjectives && <Zap className={`w-5 h-5 ${colorStyles.accentText}`} />}
                {isCompletion && <Award className="w-5 h-5 text-emerald-400" />}
                {isScience && <BookOpen className={`w-5 h-5 ${colorStyles.accentText}`} />}
                <span>{renderInline(el.text)}</span>
              </div>
            );
          }

          case 'h4':
            return (
              <h4 key={idx} className="text-sm font-bold text-slate-200 uppercase tracking-wider pt-2">
                {renderInline(el.text)}
              </h4>
            );

          case 'p':
            return (
              <p key={idx} className="text-sm sm:text-base text-slate-300 leading-relaxed">
                {renderInline(el.text)}
              </p>
            );

          case 'ordered-list-item':
            return (
              <div key={idx} className="flex items-start gap-3 text-sm sm:text-base text-slate-200 pl-2">
                <div className={`w-5 h-5 rounded-full ${colorStyles.accentBg} ${colorStyles.accentText} border ${colorStyles.accentBorder} flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5`}>
                  ✓
                </div>
                <div className="flex-1">{renderInline(el.text)}</div>
              </div>
            );

          case 'unordered-list-item':
            return (
              <div key={idx} className="flex items-start gap-3 text-sm sm:text-base text-slate-200 pl-2">
                <div className="w-1.5 h-1.5 rounded-full bg-emerald-400 mt-2.5 flex-shrink-0" />
                <div className="flex-1">{renderInline(el.text)}</div>
              </div>
            );

          case 'code':
            return (
              <div key={idx} className="p-4 rounded-xl bg-slate-950 border border-slate-800 font-mono text-xs sm:text-sm text-slate-300 overflow-x-auto shadow-inner">
                <pre className="whitespace-pre">{el.code}</pre>
              </div>
            );

          case 'table':
            return (
              <div key={idx} className="my-4 overflow-x-auto rounded-xl border border-slate-800 shadow-xl">
                <table className="w-full text-left text-xs sm:text-sm">
                  <thead className="bg-slate-900/90 text-white font-bold border-b border-slate-800">
                    <tr>
                      {el.headers.map((h, hIdx) => (
                        <th key={hIdx} className="px-4 py-3 tracking-wider font-display">
                          {renderInline(h)}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-800/60 bg-slate-950/60">
                    {el.rows.map((row, rIdx) => (
                      <tr key={rIdx} className={rIdx % 2 === 0 ? 'bg-slate-950/40' : 'bg-slate-900/20'}>
                        {row.map((cell, cIdx) => (
                          <td key={cIdx} className="px-4 py-3 text-slate-300">
                            {renderInline(cell)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );

          default:
            return null;
        }
      })}
    </div>
  );
};

import React, { useState } from 'react';
import { DOWNLOADABLE_PDFS } from '../../data/downloadablePdfs';
import { TRACKS } from '../../data/coursesData';
import { useAuth } from '../../context/AuthContext';
import { FileText, Download, Lock, Dumbbell, Flame, Zap, Trophy, Eye, ExternalLink, X, CheckCircle } from 'lucide-react';
import { getPurchasedPrograms } from './PowerliftingProgramSelector';

const TRACK_ICONS = { build: Dumbbell, cut: Flame, gain: Zap, powerlifting: Trophy, bundle: Trophy };
const TRACK_COLORS = {
  build: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
  cut: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20',
  gain: 'text-amber-400 bg-amber-500/10 border-amber-500/20',
  powerlifting: 'text-purple-400 bg-purple-500/10 border-purple-500/20',
  bundle: 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
};

const PL_PDF_MAP = {
  'pdf-pl-squat': 'pl-squat',
  'pdf-pl-bench': 'pl-bench',
  'pdf-pl-deadlift': 'pl-deadlift',
};

export const PdfLibrary = ({ selectedTrackId, onSelectTrack }) => {
  const { user, isEnrolled, openAuth } = useAuth();
  const [filter, setFilter] = useState('all');
  const [downloadedIds, setDownloadedIds] = useState([]);
  const [previewPdf, setPreviewPdf] = useState(null);

  const pdfs = filter === 'all' ? DOWNLOADABLE_PDFS : DOWNLOADABLE_PDFS.filter(p => p.trackId === filter || (filter === 'bundle' && p.trackId === 'bundle'));

  const checkUserAccess = (pdf) => {
    if (!user) return false;
    if (isEnrolled('course-bundle-all')) return true;

    // Check specific Powerlifting program unlock
    if (pdf.trackId === 'powerlifting') {
      const plProgId = PL_PDF_MAP[pdf.id];
      const purchasedPL = getPurchasedPrograms();
      if (plProgId && purchasedPL.includes(plProgId)) return true;
      if (isEnrolled('course-powerlifting') && purchasedPL.length === 0) {
        // If enrolled in course but no specific program stored, allow first
        return true;
      }
      return false;
    }

    if (isEnrolled('course-' + pdf.trackId)) return true;
    return false;
  };

  const handleDownload = (pdf) => {
    if (!user) { openAuth('signup'); return; }
    if (!checkUserAccess(pdf)) {
      alert(`Enroll in the ${pdf.trackId.toUpperCase()} track (or Full Access Pass) to unlock this resource.`);
      return;
    }
    const a = document.createElement('a');
    a.href = pdf.fileUrl;
    a.download = pdf.title.replace(/[^a-zA-Z0-9]/g, '_') + '.pdf';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setDownloadedIds(prev => [...prev, pdf.id]);
  };

  return (
    <div className="max-w-5xl mx-auto px-4 py-12">
      <div className="mb-8">
        <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
          📑 Official Kaizen Fitness Academy Blueprints &amp; Workbooks
        </div>
        <h1 className="text-3xl font-black text-white font-display mb-2">PDF Program &amp; Workbook Vault</h1>
        <p className="text-slate-400">Authentic 12-week workout plans, nutrition workbooks, periodized tracking sheets, and powerlifting peaking blueprints. Download or view online.</p>
      </div>

      {/* Filters */}
      <div className="flex flex-wrap gap-2 mb-8">
        <button
          onClick={() => setFilter('all')}
          className={`px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${
            filter === 'all' ? 'bg-slate-700 text-white' : 'bg-slate-900 text-slate-400 border border-slate-800 hover:text-white'
          }`}
        >
          All Resources ({DOWNLOADABLE_PDFS.length})
        </button>
        {TRACKS.map(t => {
          const Icon = TRACK_ICONS[t.id] || FileText;
          return (
            <button
              key={t.id}
              onClick={() => setFilter(t.id)}
              className={`flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm font-medium transition-all border ${
                filter === t.id ? TRACK_COLORS[t.id] : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-white'
              }`}
            >
              <Icon className="w-4 h-4" />{t.id.charAt(0).toUpperCase() + t.id.slice(1)}
            </button>
          );
        })}
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
        {pdfs.map(pdf => {
          const enrolled = checkUserAccess(pdf);
          const downloaded = downloadedIds.includes(pdf.id);
          const Icon = TRACK_ICONS[pdf.trackId] || FileText;
          const colors = TRACK_COLORS[pdf.trackId] || TRACK_COLORS.build;

          return (
            <div key={pdf.id} className="p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all flex flex-col justify-between">
              <div>
                <div className="flex items-center justify-between mb-3">
                  <span className={`flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${colors}`}>
                    <Icon className="w-3 h-3" />
                    {pdf.category}
                  </span>
                  <span className="text-xs text-slate-500 font-mono">{pdf.pages} Pages · {pdf.fileSize}</span>
                </div>

                <h3 className="text-base font-bold text-white mb-2 leading-snug">{pdf.title}</h3>
                <p className="text-xs text-slate-400 mb-4 leading-relaxed">{pdf.description}</p>

                {/* Content preview tags */}
                <div className="space-y-1.5 mb-5 p-3 rounded-xl bg-slate-950 border border-slate-800/80">
                  {pdf.previewSections?.map((sec, idx) => (
                    <div key={idx} className="text-xs text-slate-300">
                      <span className="text-emerald-400 font-semibold">{sec.title}: </span>
                      <span className="text-slate-400 line-clamp-1">{sec.text}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="flex items-center gap-2 pt-3 border-t border-slate-800/80">
                <button
                  onClick={() => setPreviewPdf(pdf)}
                  className="flex-1 py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-semibold rounded-xl text-xs flex items-center justify-center gap-1.5 transition-colors border border-slate-700"
                >
                  <Eye className="w-3.5 h-3.5" />
                  View Online
                </button>

                <button
                  onClick={() => handleDownload(pdf)}
                  className={`flex-1 py-2 px-3 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-all ${
                    enrolled
                      ? downloaded
                        ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                        : 'bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-md shadow-emerald-500/20'
                      : 'bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700'
                  }`}
                >
                  {enrolled ? (
                    downloaded ? (
                      <>
                        <CheckCircle className="w-3.5 h-3.5" />
                        Saved
                      </>
                    ) : (
                      <>
                        <Download className="w-3.5 h-3.5" />
                        Download PDF
                      </>
                    )
                  ) : (
                    <>
                      <Lock className="w-3.5 h-3.5" />
                      Enroll to Unlock
                    </>
                  )}
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Online PDF Viewer Modal */}
      {previewPdf && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md animate-in fade-in duration-200">
          <div className="relative w-full max-w-4xl h-[85vh] bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl flex flex-col overflow-hidden">
            {/* Modal Header */}
            <div className="flex items-center justify-between px-5 py-3.5 border-b border-slate-800 bg-slate-950 flex-shrink-0">
              <div className="flex items-center gap-2.5 min-w-0">
                <FileText className="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span className="text-sm font-bold text-white truncate">{previewPdf.title}</span>
                <span className="text-xs text-slate-500 hidden sm:inline font-mono">({previewPdf.pages} Pages)</span>
              </div>
              <div className="flex items-center gap-2">
                <a
                  href={previewPdf.fileUrl}
                  target="_blank"
                  rel="noreferrer"
                  className="px-2.5 py-1 text-xs text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg flex items-center gap-1 transition-colors"
                >
                  <ExternalLink className="w-3 h-3" />
                  New Tab
                </a>
                <button
                  onClick={() => setPreviewPdf(null)}
                  className="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>
            </div>

            {/* Embedded Iframe */}
            <div className="flex-1 bg-slate-950 relative">
              <iframe
                src={`${previewPdf.fileUrl}#view=FitH`}
                title={previewPdf.title}
                className="w-full h-full border-0"
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

import React, { useState } from 'react';
import {
  CheckCircle,
  Circle,
  Download,
  FileText,
  Lock,
  Plus,
  ShoppingCart,
  Sparkles,
  ChevronDown,
  ChevronUp,
} from 'lucide-react';
import { POWERLIFTING_PROGRAMS, PL_ADDON_PRICE } from '../../data/powerliftingPrograms';
import { useAuth } from '../../context/AuthContext';

/**
 * PowerliftingProgramSelector
 *
 * Displayed on the Powerlifting course detail / checkout page.
 * – Lets the customer pick 1 program (included in base price).
 * – Additional programs cost ₹50 each.
 * – After purchase, only unlocked programs are downloadable.
 * – Already-purchased programs are never re-charged.
 */
export const PowerliftingProgramSelector = ({
  mode = 'checkout', // 'checkout' | 'dashboard'
  onSelectionChange,
  selectedIds: controlledIds,
}) => {
  const { user } = useAuth();

  // Programs the user has already purchased (stored in localStorage)
  const purchasedIds = (() => {
    try {
      const raw = localStorage.getItem('kaizen_pl_programs');
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  })();

  const [internalSelected, setInternalSelected] = useState([]);
  const selectedIds = controlledIds ?? internalSelected;
  const setSelectedIds = (ids) => {
    setInternalSelected(ids);
    onSelectionChange?.(ids);
  };

  const [expandedId, setExpandedId] = useState(null);

  // ── CHECKOUT MODE ──────────────────────────────────────────
  if (mode === 'checkout') {
    const newSelections = selectedIds.filter((id) => !purchasedIds.includes(id));
    const freeSlots = Math.max(0, 1 - purchasedIds.length); // 1 free slot if they haven't bought any yet
    const freeSelectionsUsed = Math.min(freeSlots, newSelections.length);
    const paidAddons = Math.max(0, newSelections.length - freeSelectionsUsed);
    const addonTotal = paidAddons * PL_ADDON_PRICE;

    const toggleProgram = (programId) => {
      if (purchasedIds.includes(programId)) return; // already owned
      setSelectedIds(
        selectedIds.includes(programId)
          ? selectedIds.filter((id) => id !== programId)
          : [...selectedIds, programId]
      );
    };

    return (
      <div className="space-y-3">
        <div className="flex items-center justify-between">
          <h3 className="text-sm font-black text-white uppercase tracking-wider flex items-center gap-2">
            <FileText className="w-4 h-4 text-purple-400" />
            Select Your Programs
          </h3>
          <span className="text-[11px] text-slate-400">
            1 included · +₹{PL_ADDON_PRICE} each additional
          </span>
        </div>

        <div className="space-y-2">
          {POWERLIFTING_PROGRAMS.map((prog) => {
            const isOwned = purchasedIds.includes(prog.id);
            const isSelected = selectedIds.includes(prog.id);
            const isExpanded = expandedId === prog.id;

            return (
              <div key={prog.id} className="rounded-xl border overflow-hidden transition-all">
                {/* Card Header */}
                <button
                  onClick={() => !isOwned && toggleProgram(prog.id)}
                  disabled={isOwned}
                  className={`w-full p-4 text-left transition-all flex items-start gap-3 ${
                    isOwned
                      ? 'bg-purple-500/5 border-purple-500/20 opacity-70 cursor-default'
                      : isSelected
                      ? 'bg-purple-500/10 border-purple-500/40'
                      : 'bg-slate-900 border-slate-800 hover:border-slate-700 cursor-pointer'
                  }`}
                >
                  {/* Checkbox */}
                  <div className="mt-0.5 flex-shrink-0">
                    {isOwned ? (
                      <div className="w-5 h-5 rounded-full bg-purple-500 flex items-center justify-center">
                        <CheckCircle className="w-3.5 h-3.5 text-white" />
                      </div>
                    ) : isSelected ? (
                      <div className="w-5 h-5 rounded-full bg-purple-500 flex items-center justify-center">
                        <CheckCircle className="w-3.5 h-3.5 text-white" />
                      </div>
                    ) : (
                      <Circle className="w-5 h-5 text-slate-600" />
                    )}
                  </div>

                  {/* Content */}
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-0.5">
                      <span className="text-lg">{prog.icon}</span>
                      <span className="text-sm font-bold text-white">{prog.name}</span>
                      {isOwned && (
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 border border-purple-500/30">
                          OWNED
                        </span>
                      )}
                    </div>
                    <p className="text-[11px] text-purple-400 font-semibold">{prog.subtitle}</p>
                    <p className="text-xs text-slate-400 mt-1 line-clamp-2">{prog.description}</p>
                  </div>

                  {/* Price badge */}
                  <div className="flex-shrink-0 text-right">
                    {isOwned ? (
                      <span className="text-[11px] text-slate-500">Already purchased</span>
                    ) : (
                      <span className="text-xs font-bold text-slate-300">
                        {selectedIds.indexOf(prog.id) === 0 && purchasedIds.length === 0
                          ? 'Included'
                          : `+₹${PL_ADDON_PRICE}`}
                      </span>
                    )}
                  </div>
                </button>

                {/* Expand/Preview Toggle */}
                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    setExpandedId(isExpanded ? null : prog.id);
                  }}
                  className="w-full py-1.5 bg-slate-950 border-t border-slate-800 text-[10px] text-slate-400 hover:text-white transition-colors flex items-center justify-center gap-1"
                >
                  {isExpanded ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
                  {isExpanded ? 'Hide Details' : 'Preview Program Details'}
                </button>

                {/* Expanded Details */}
                {isExpanded && (
                  <div className="p-4 bg-slate-950 border-t border-slate-800 space-y-2">
                    <h4 className="text-xs font-bold text-white uppercase tracking-wider">
                      What's Inside:
                    </h4>
                    <ul className="space-y-1.5">
                      {prog.highlights.map((h, i) => (
                        <li key={i} className="flex items-start gap-2 text-xs text-slate-300">
                          <CheckCircle className="w-3.5 h-3.5 text-purple-400 flex-shrink-0 mt-0.5" />
                          {h}
                        </li>
                      ))}
                    </ul>
                    <div className="pt-2 text-[10px] text-slate-500 flex items-center gap-2">
                      <FileText className="w-3 h-3" /> Full PDF program with weekly periodization
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* Pricing summary */}
        {newSelections.length > 0 && (
          <div className="p-3 rounded-xl bg-purple-500/10 border border-purple-500/30 space-y-1">
            <div className="flex items-center justify-between text-xs">
              <span className="text-slate-300">
                {newSelections.length} program{newSelections.length > 1 ? 's' : ''} selected
              </span>
              {freeSelectionsUsed > 0 && (
                <span className="text-purple-400 font-semibold">
                  {freeSelectionsUsed} included in base price
                </span>
              )}
            </div>
            {paidAddons > 0 && (
              <div className="flex items-center justify-between text-xs">
                <span className="text-slate-400">
                  {paidAddons} additional × ₹{PL_ADDON_PRICE}
                </span>
                <span className="text-white font-bold">+₹{addonTotal}</span>
              </div>
            )}
          </div>
        )}

        {selectedIds.length === 0 && (
          <p className="text-[11px] text-amber-400 text-center py-1">
            Please select at least one program to continue
          </p>
        )}
      </div>
    );
  }

  // ── DASHBOARD MODE ──────────────────────────────────────────
  // Shows purchased programs with download buttons + option to buy more
  const unpurchased = POWERLIFTING_PROGRAMS.filter((p) => !purchasedIds.includes(p.id));

  return (
    <div className="space-y-4">
      <h3 className="text-sm font-black text-white uppercase tracking-wider flex items-center gap-2">
        <FileText className="w-4 h-4 text-purple-400" />
        Your Powerlifting Programs
      </h3>

      {/* Purchased Programs */}
      {purchasedIds.length > 0 ? (
        <div className="space-y-2">
          {POWERLIFTING_PROGRAMS.filter((p) => purchasedIds.includes(p.id)).map((prog) => (
            <div
              key={prog.id}
              className="p-4 rounded-xl bg-slate-900 border border-purple-500/30 flex items-center justify-between gap-4"
            >
              <div className="flex items-center gap-3 min-w-0">
                <span className="text-2xl">{prog.icon}</span>
                <div className="min-w-0">
                  <div className="text-sm font-bold text-white">{prog.name}</div>
                  <div className="text-[11px] text-purple-400">{prog.subtitle}</div>
                </div>
              </div>
              <a
                href={prog.pdfFile}
                download={prog.pdfFileName}
                target="_blank"
                rel="noreferrer"
                className="flex-shrink-0 flex items-center gap-1.5 px-4 py-2 bg-purple-500 hover:bg-purple-400 text-white font-bold text-xs rounded-lg transition-all shadow-md shadow-purple-500/20"
              >
                <Download className="w-3.5 h-3.5" />
                Download PDF
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div className="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center">
          <Lock className="w-6 h-6 text-slate-500 mx-auto mb-2" />
          <p className="text-xs text-slate-400">No programs purchased yet.</p>
        </div>
      )}

      {/* Buy More */}
      {unpurchased.length > 0 && (
        <div className="space-y-2">
          <h4 className="text-xs font-bold text-slate-400 uppercase tracking-wider">
            Unlock Additional Programs — ₹{PL_ADDON_PRICE} each
          </h4>
          {unpurchased.map((prog) => (
            <div
              key={prog.id}
              className="p-3 rounded-xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-3"
            >
              <div className="flex items-center gap-2 min-w-0">
                <span className="text-lg">{prog.icon}</span>
                <div className="min-w-0">
                  <div className="text-xs font-bold text-white">{prog.name}</div>
                  <div className="text-[10px] text-slate-400">{prog.subtitle}</div>
                </div>
              </div>
              <button
                onClick={() => {
                  // Opens Razorpay for ₹50 addon purchase
                  const payUrl = `https://razorpay.me/@rajashokrai?amount=${PL_ADDON_PRICE}`;
                  window.open(payUrl, '_blank');
                  // After payment, save to localStorage
                  setTimeout(() => {
                    const current = JSON.parse(localStorage.getItem('kaizen_pl_programs') || '[]');
                    if (!current.includes(prog.id)) {
                      localStorage.setItem(
                        'kaizen_pl_programs',
                        JSON.stringify([...current, prog.id])
                      );
                      window.location.reload();
                    }
                  }, 3000);
                }}
                className="flex-shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-purple-500/20 hover:bg-purple-500/30 text-purple-400 font-bold text-[11px] rounded-lg transition-all border border-purple-500/30"
              >
                <Plus className="w-3 h-3" />
                Buy ₹{PL_ADDON_PRICE}
              </button>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

/**
 * Utility: save purchased program IDs to localStorage after checkout.
 */
export const savePurchasedPrograms = (programIds) => {
  try {
    const existing = JSON.parse(localStorage.getItem('kaizen_pl_programs') || '[]');
    const merged = Array.from(new Set([...existing, ...programIds]));
    localStorage.setItem('kaizen_pl_programs', JSON.stringify(merged));
  } catch {
    localStorage.setItem('kaizen_pl_programs', JSON.stringify(programIds));
  }
};

/**
 * Utility: get purchased program IDs from localStorage.
 */
export const getPurchasedPrograms = () => {
  try {
    return JSON.parse(localStorage.getItem('kaizen_pl_programs') || '[]');
  } catch {
    return [];
  }
};

import React, { useState } from 'react';
import { useAuth } from '../../context/AuthContext';
import { CheckCircle, X, Award, RefreshCw } from 'lucide-react';
import confetti from 'canvas-confetti';

export const QuizEngine = ({ quizData, courseId, onComplete }) => {
  const [answers, setAnswers] = useState({});
  const [submitted, setSubmitted] = useState(false);
  const [score, setScore] = useState(0);

  if (!quizData) return null;
  const { title, questions, passingScore } = quizData;

  const handleSelect = (qId, idx) => {
    if (submitted) return;
    setAnswers(prev => ({ ...prev, [qId]: idx }));
  };

  const handleSubmit = () => {
    let correct = 0;
    questions.forEach(q => { if (answers[q.id] === q.correctAnswer) correct++; });
    const pct = Math.round((correct / questions.length) * 100);
    setScore(pct);
    setSubmitted(true);
    if (pct >= passingScore) {
      try {
        confetti({ particleCount: 150, spread: 80, origin: { y: 0.5 }, colors: ['#22c55e', '#eab308', '#ffffff'] });
      } catch (e) {}
      if (onComplete) onComplete(pct, true);
    } else {
      if (onComplete) onComplete(pct, false);
    }
  };

  const handleRetry = () => {
    setAnswers({});
    setSubmitted(false);
    setScore(0);
  };

  const allAnswered = questions.every(q => answers[q.id] !== undefined);
  const passed = score >= passingScore;

  return (
    <div className="w-full max-w-2xl mx-auto bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
      <div className="p-5 border-b border-slate-800">
        <div className="text-xs text-amber-400 font-bold uppercase tracking-wider mb-1">📝 Course Quiz</div>
        <h3 className="text-base font-bold text-white">{title}</h3>
        <p className="text-xs text-slate-400 mt-1">Pass mark: {passingScore}% · {questions.length} questions</p>
      </div>

      {submitted ? (
        <div className="p-6 text-center space-y-4">
          <div className={`w-16 h-16 rounded-full mx-auto flex items-center justify-center ${
            passed ? 'bg-emerald-500/20 border-2 border-emerald-500' : 'bg-rose-500/20 border-2 border-rose-500'
          }`}>
            {passed ? <Award className="w-8 h-8 text-emerald-400" /> : <X className="w-8 h-8 text-rose-400" />}
          </div>
          <div>
            <div className={`text-4xl font-black ${passed ? 'text-emerald-400' : 'text-rose-400'}`}>{score}%</div>
            <div className="text-white font-bold mt-1">{passed ? '🎉 Passed! Certificate Unlocked!' : 'Not Quite — Try Again'}</div>
            <div className="text-sm text-slate-400 mt-1">{passed ? 'Your completion certificate is now available on your dashboard.' : `You need ${passingScore}% to pass. Review the lesson notes and retry.`}</div>
          </div>

          {/* Review answers */}
          <div className="text-left space-y-3 mt-4">
            {questions.map((q, idx) => {
              const correct = answers[q.id] === q.correctAnswer;
              return (
                <div key={q.id} className={`p-3 rounded-xl border text-sm ${correct ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-rose-500/30 bg-rose-500/5'}`}>
                  <div className="flex items-start gap-2">
                    {correct ? <CheckCircle className="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" /> : <X className="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" />}
                    <div>
                      <div className="text-white font-medium">{q.question}</div>
                      <div className="text-xs text-slate-400 mt-1">✓ {q.options[q.correctAnswer]}</div>
                      <div className="text-xs text-slate-500 mt-1 italic">{q.explanation}</div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>

          {!passed && (
            <button onClick={handleRetry} className="flex items-center gap-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-sm font-semibold mx-auto transition-all">
              <RefreshCw className="w-4 h-4" /> Retry Quiz
            </button>
          )}
        </div>
      ) : (
        <div className="p-5 space-y-5">
          {questions.map((q, qIdx) => (
            <div key={q.id}>
              <div className="text-sm font-semibold text-white mb-3">
                <span className="text-slate-500 mr-2">Q{qIdx + 1}.</span>{q.question}
              </div>
              <div className="space-y-2">
                {q.options.map((opt, i) => (
                  <button
                    key={i}
                    onClick={() => handleSelect(q.id, i)}
                    className={`w-full text-left px-4 py-2.5 rounded-xl border text-sm transition-all ${
                      answers[q.id] === i
                        ? 'border-emerald-500 bg-emerald-500/10 text-emerald-300'
                        : 'border-slate-800 bg-slate-950 text-slate-300 hover:border-slate-700'
                    }`}
                  >
                    <span className="font-bold mr-2 text-slate-500">{String.fromCharCode(65 + i)}.</span>{opt}
                  </button>
                ))}
              </div>
            </div>
          ))}
          <button
            onClick={handleSubmit}
            disabled={!allAnswered}
            className="w-full py-3 bg-amber-500 hover:bg-amber-400 disabled:opacity-40 disabled:cursor-not-allowed text-slate-950 font-bold rounded-xl text-sm transition-all"
          >
            Submit Answers ({Object.keys(answers).length}/{questions.length} answered)
          </button>
        </div>
      )}
    </div>
  );
};

import React from 'react';
import { useAuth } from '../../context/AuthContext';
import { useWorkout } from '../../context/WorkoutContext';
import { COURSES, TRACKS } from '../../data/coursesData';
import {
  Flame, Award, Activity, BookOpen, Calendar, CheckSquare,
  FileText, Play, Calculator, ArrowRight, Dumbbell, Zap, Trophy,
  Download, Sparkles
} from 'lucide-react';
import { PowerliftingProgramSelector, getPurchasedPrograms } from '../course/PowerliftingProgramSelector';

const TRACK_COLORS = {
  build: { label: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', btn: 'bg-emerald-500 hover:bg-emerald-400' },
  cut: { label: 'text-cyan-400', bg: 'bg-cyan-500/10', border: 'border-cyan-500/20', btn: 'bg-cyan-500 hover:bg-cyan-400' },
  gain: { label: 'text-amber-400', bg: 'bg-amber-500/10', border: 'border-amber-500/20', btn: 'bg-amber-500 hover:bg-amber-400' },
  powerlifting: { label: 'text-purple-400', bg: 'bg-purple-500/10', border: 'border-purple-500/20', btn: 'bg-purple-500 hover:bg-purple-400' },
};

export const UserDashboard = ({ onEnterClassroom, onViewCourse, setCurrentView }) => {
  const { user, isLessonCompleted, openAuth } = useAuth();
  const { progressLogs, completedWorkouts } = useWorkout();

  if (!user) {
    return (
      <div className="max-w-3xl mx-auto px-4 py-20 text-center">
        <div className="text-4xl mb-4">🔒</div>
        <h2 className="text-xl font-bold text-white mb-2">Please log in to view your dashboard</h2>
        <p className="text-slate-400 mb-6">Your progress, enrolled courses, and stats are all saved securely.</p>
        <button
          onClick={() => openAuth('login')}
          className="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-sm transition-all shadow-lg shadow-emerald-500/20 cursor-pointer"
        >
          Log In / Join Free
        </button>
      </div>
    );
  }

  const enrolledCourses = COURSES.filter(c => user.enrolledCourseIds?.includes(c.id));
  const hasPowerlifting = user.enrolledCourseIds?.includes('course-powerlifting') || user.enrolledCourseIds?.includes('course-bundle-all');
  const purchasedPLPrograms = getPurchasedPrograms();

  // Compute progress per enrolled course
  const courseProgress = enrolledCourses.map(course => {
    const allLessons = course.modules?.flatMap(m => m.lessons) || [];
    const completed = allLessons.filter(l => isLessonCompleted(l.id)).length;
    const pct = allLessons.length > 0 ? Math.round((completed / allLessons.length) * 100) : 0;
    const quizPassed = user.quizScores?.[course.id]?.passed;
    return { course, total: allLessons.length, completed, pct, quizPassed };
  });

  const latestWeight = progressLogs[0]?.weight;

  const toolCards = [
    { icon: Activity, label: 'Workout Log', sub: 'Log sets · reps · weight · RIR', view: 'tracker', color: 'text-emerald-400' },
    { icon: Calculator, label: 'Nutrition Calc', sub: 'Calories & macros for your goal', view: 'nutrition', color: 'text-amber-400' },
    { icon: Calendar, label: '12-Week Program', sub: 'View your periodized plan', view: 'program', color: 'text-purple-400' },
    { icon: CheckSquare, label: 'Weekly Checklist', sub: 'Track daily habits', view: 'checklist', color: 'text-cyan-400' },
    { icon: FileText, label: 'PDF Library', sub: 'Download workbooks & blueprints', view: 'resources', color: 'text-rose-400' },
    { icon: BookOpen, label: 'All Courses', sub: 'Browse the full catalog', view: 'curriculum', color: 'text-blue-400' },
  ];

  return (
    <div className="max-w-5xl mx-auto px-4 py-10">
      {/* Welcome Header */}
      <div className="flex items-center gap-4 mb-8">
        <img src={user.avatar} alt={user.name} className="w-16 h-16 rounded-2xl object-cover ring-4 ring-emerald-500/20" />
        <div>
          <div className="text-2xl font-black text-white font-display">Welcome back, {user.name.split(' ')[0]} 👋</div>
          <div className="text-sm text-slate-400 mt-0.5 flex flex-wrap items-center gap-3">
            <span className="flex items-center gap-1.5">
              <Flame className="w-4 h-4 text-amber-400" />
              <span className="font-bold text-amber-400">{user.currentStreak}</span> day streak
            </span>
            <span>{enrolledCourses.length} course{enrolledCourses.length !== 1 ? 's' : ''} enrolled</span>
            <span>Joined {user.joinedDate}</span>
          </div>
        </div>
      </div>

      {/* Quick Stats Row */}
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
        {[
          { label: 'Courses Enrolled', value: enrolledCourses.length, icon: BookOpen, color: 'text-emerald-400' },
          { label: 'Lessons Completed', value: user.completedLessonIds?.length || 0, icon: Award, color: 'text-amber-400' },
          { label: 'Workouts Logged', value: completedWorkouts.length, icon: Activity, color: 'text-cyan-400' },
          { label: 'Current Weight', value: latestWeight ? `${latestWeight} kg` : '—', icon: Dumbbell, color: 'text-purple-400' },
        ].map(stat => (
          <div key={stat.label} className="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <stat.icon className={`w-5 h-5 ${stat.color} mb-2`} />
            <div className="text-xl font-black text-white">{stat.value}</div>
            <div className="text-xs text-slate-400">{stat.label}</div>
          </div>
        ))}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* ── My Courses ── */}
        <div className="lg:col-span-2 space-y-6">
          <div>
            <h2 className="text-base font-bold text-white mb-3 flex items-center gap-2">
              <BookOpen className="w-4 h-4 text-emerald-400" /> My Enrolled Courses
            </h2>

            {enrolledCourses.length === 0 ? (
              <div className="p-8 rounded-xl bg-slate-900 border border-dashed border-slate-800 text-center">
                <p className="text-slate-400 text-sm mb-4">You haven't enrolled in any course yet.</p>
                <button
                  onClick={() => setCurrentView('curriculum')}
                  className="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-sm transition-all"
                >
                  Browse Courses
                </button>
              </div>
            ) : (
              <div className="space-y-3">
                {courseProgress.map(({ course, total, completed, pct, quizPassed }) => {
                  const color = TRACK_COLORS[course.trackId] || TRACK_COLORS.build;
                  return (
                    <div key={course.id} className="p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all">
                      <div className="flex items-start gap-4">
                        <img src={course.thumbnail} alt={course.title} className="w-20 h-14 rounded-lg object-cover flex-shrink-0" />
                        <div className="flex-1 min-w-0">
                          <div className={`text-[11px] font-bold uppercase tracking-wider ${color.label} mb-0.5`}>{course.trackId} track</div>
                          <h3 className="text-sm font-bold text-white leading-snug line-clamp-1">{course.title}</h3>
                          <div className="flex items-center gap-3 mt-1.5">
                            <div className="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
                              <div className={`h-full rounded-full transition-all ${pct > 0 ? `bg-emerald-500` : 'bg-slate-700'}`} style={{ width: `${pct}%` }} />
                            </div>
                            <span className="text-[11px] text-slate-400 flex-shrink-0">{completed}/{total} lessons · {pct}%</span>
                          </div>
                          {quizPassed && (
                            <div className="mt-1.5 flex items-center gap-1 text-[11px] text-amber-400 font-semibold">
                              <Award className="w-3 h-3" /> Certificate Earned
                            </div>
                          )}
                        </div>
                        <button
                          onClick={() => onEnterClassroom(course)}
                          className={`flex-shrink-0 flex items-center gap-1.5 px-3 py-2 ${color.btn} text-slate-950 font-bold rounded-lg text-xs transition-all`}
                        >
                          <Play className="w-3.5 h-3.5" /> Continue
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          {/* ── Powerlifting Programs Section (if enrolled or purchased) ── */}
          {(hasPowerlifting || purchasedPLPrograms.length > 0) && (
            <div className="p-5 rounded-2xl bg-purple-950/20 border border-purple-500/30">
              <div className="flex items-center justify-between mb-4">
                <div className="flex items-center gap-2">
                  <Trophy className="w-5 h-5 text-purple-400" />
                  <h3 className="text-base font-bold text-white font-display">
                    Powerlifting Blueprint Programs
                  </h3>
                </div>
                <span className="text-[11px] font-bold px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">
                  {purchasedPLPrograms.length} of 3 Programs Unlocked
                </span>
              </div>
              <PowerliftingProgramSelector mode="dashboard" />
            </div>
          )}

          {/* Recent workouts */}
          {completedWorkouts.length > 0 && (
            <div>
              <h2 className="text-base font-bold text-white mt-2 mb-3">🏋️ Recent Workouts</h2>
              <div className="rounded-xl bg-slate-900 border border-slate-800 divide-y divide-slate-800/50">
                {completedWorkouts.slice(0, 5).map(w => (
                  <div key={w.id} className="flex items-center gap-3 px-4 py-3">
                    <div className="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
                      <Dumbbell className="w-4 h-4 text-emerald-400" />
                    </div>
                    <div className="flex-1">
                      <div className="text-sm font-medium text-white">{w.workoutName}</div>
                      <div className="text-xs text-slate-400">{w.date} · {w.durationMinutes} min · {w.exercisesLogged} exercises</div>
                    </div>
                    <div className="text-sm font-bold text-emerald-400">{w.totalVolumeKg?.toLocaleString()} kg</div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* ── Tools Sidebar ── */}
        <div>
          <h2 className="text-base font-bold text-white mb-4">⚡ Quick Access</h2>
          <div className="space-y-2">
            {toolCards.map(tool => (
              <button
                key={tool.view}
                onClick={() => setCurrentView(tool.view)}
                className="w-full flex items-center gap-3 p-3.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all text-left group"
              >
                <tool.icon className={`w-5 h-5 ${tool.color} flex-shrink-0`} />
                <div className="flex-1 min-w-0">
                  <div className="text-sm font-semibold text-white">{tool.label}</div>
                  <div className="text-xs text-slate-500">{tool.sub}</div>
                </div>
                <ArrowRight className="w-3.5 h-3.5 text-slate-600 group-hover:text-slate-400 transition-colors" />
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

import React from 'react';
import { TRACKS, COURSES } from '../../data/coursesData';
import { useAuth } from '../../context/AuthContext';
import {
  Star, Users, Clock, Play, ArrowRight, Shield, Award,
  Dumbbell, Flame, Zap, Trophy, CheckCircle, TrendingUp, FileText
