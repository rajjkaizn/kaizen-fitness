          { week: 2, focus: 'Adding Cardio Layer', days: ['Add 3× 25-min incline treadmill LISS sessions.', 'Keep lifting intensity high — RPE 8.', 'Track scale weight daily — average weekly.'], rpe: '8', notes: 'LISS should feel like a brisk walk, not running.' },
          { week: 3, focus: 'HIIT Introduction', days: ['Replace 1 LISS session with 20-min HIIT (8s on / 12s off).', 'Calorie cycle: eat TDEE on heavy lifting days, deficit on rest days.'], rpe: '8.5', notes: 'High day / low day cycling maintains anabolism.' },
        ]
      },
      {
        phase: 'Phase 2: Acceleration & Refeed (Weeks 4–6)',
        goal: 'Sustain deficit, execute refeed days, manage metabolic adaptation.',
        weeks: [
          { week: 4, focus: 'Refeed Day Protocol', days: ['Execute first full refeed: TDEE + 20% carbs, fat at minimum.', 'Scale weight will increase 0.5–1 kg — this is glycogen, not fat.', 'Workout performance on day after refeed should be excellent.'], rpe: '8', notes: 'The refeed is not a cheat day — it is precision nutrition.' },
          { week: 5, focus: 'Volume Peak + Low Carb', days: ['Lowest carb week of the program.', 'Carbs only around training.', 'High vegetable volume for satiety.'], rpe: '8.5', notes: 'Expect some performance dip. This is normal on low carbs.' },
          { week: 6, focus: 'Diet Break', days: ['Full 1-week diet break at maintenance calories.', 'Continue lifting and steps — no changes to activity.', 'Leptin and hormones restore to baseline.'], rpe: '7', notes: 'Diet breaks are mandatory. Skipping them prolongs cuts.' },
        ]
      },
      {
        phase: 'Phase 3: Final Polish (Weeks 7–8)',
        goal: 'Final push to target body fat, water management, and peak conditioning.',
        weeks: [
          { week: 7, focus: 'Peak Deficit Week', days: ['Drop 200 kcal further below previous deficit.', 'Maximise NEAT — walk everywhere.', 'Add morning fasted LISS (30 min) on 3 days.'], rpe: '8', notes: 'Deepest deficit of the entire program. Temporary.' },
          { week: 8, focus: 'Final Assessment', days: ['Return to maintenance calories for 3 days (final refeed).', 'Test body composition — skinfold or DEXA if available.', 'Complete shred quiz and receive certificate.'], rpe: '7', notes: 'Congratulations — you have completed the Sub-10% Protocol.' },
        ]
      }
    ]
  },
  gain: {
    name: 'Mass Monster Clean Bulk — 10-Week Program',
    phases: [
      {
        phase: 'Phase 1: Caloric Adaptation (Weeks 1–4)',
        goal: 'Build appetite and digestive capacity progressively without excess fat gain.',
        weeks: [
          { week: 1, focus: 'Calorie Ramp', days: ['Start at TDEE + 200 kcal.', 'Add 1 high-calorie shake daily.', 'Full-body 3× per week with all major compounds.'], rpe: '7', notes: 'Digestive system needs 2 weeks to adapt to high volume eating.' },
          { week: 2, focus: 'Ramp to Full Surplus', days: ['Increase to TDEE + 400 kcal.', 'Begin Upper/Lower 4-Day split.', 'Progressive overload on all compounds.'], rpe: '8', notes: 'Cook in bulk. Meal prepping is non-negotiable on a mass phase.' },
          { week: 3, focus: 'Volume & Strength', days: ['Add compound exercises: Barbell Row, Overhead Press, Close-Grip Bench.', 'Track weekly bodyweight (average 3 morning readings).', 'Target 0.5–0.7 kg gain per week.'], rpe: '8.5', notes: 'Gaining faster than 1 kg/week means excess fat — adjust down.' },
          { week: 4, focus: 'Deload + Digestive Reset', days: ['Reduce training volume by 40%.', 'Continue eating at full surplus.', 'Bodyweight typically jumps — mostly glycogen and water. Normal.'], rpe: '6', notes: 'Eat big. Rest big. Grow big.' },
        ]
      },
    ]
  },
  powerlifting: {
    name: 'SBD 1RM Peaking System — 16-Week Program',
    phases: [
      {
        phase: 'Phase 1: Base Strength Building (Weeks 1–6)',
        goal: 'Build raw strength foundation with moderate intensity and high technical practice.',
        weeks: [
          { week: 1, focus: 'Technique & Volume Base', days: ['Squat: 5×5 @ 70% 1RM', 'Bench: 5×5 @ 70% 1RM', 'Deadlift: 3×5 @ 75% 1RM', 'Accessories: Close-grip bench, paused squats, Romanian DL.'], rpe: '7', notes: 'Film every set. Identify technical deficiencies early.' },
          { week: 2, focus: 'Load Increase I', days: ['Add 2.5kg to Squat & Bench, 5kg to Deadlift.', 'All main movements: 4×5.', 'Accessories: moderate intensity, quality reps.'], rpe: '7.5', notes: 'Small jumps compound dramatically over 16 weeks.' },
          { week: 3, focus: 'Load Increase II', days: ['Continue adding load per week. RPE 8 target on last set.', 'Introduce tempo squats: 3s descent, no bounce out of hole.', 'Paused bench (1s pause): 3×3 at 75%.'], rpe: '8', notes: 'Paused and tempo work builds maximal strength out of sticking points.' },
