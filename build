import React from 'react';

export const KaizenLogo = ({ size = 'normal', showText = true }) => {
  const iconSize = size === 'large' ? 'w-10 h-10' : 'w-8 h-8';
  const textSize = size === 'large' ? 'text-2xl' : 'text-xl';
  const dotSize = size === 'large' ? 'text-3xl' : 'text-2xl';

  return (
    <div className="flex items-center gap-3">
      <div className={`${iconSize} bg-emerald-500 rounded-xl flex items-center justify-center shadow-lg shadow-emerald-500/20`}>
        <svg width="60%" height="60%" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="3" width="3" height="12" rx="1" fill="#0f0f0f"/>
          <line x1="7" y1="3" x2="14" y2="9" stroke="#0f0f0f" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"/>
          <line x1="7" y1="15" x2="14" y2="9" stroke="#0f0f0f" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"/>
        </svg>
      </div>
      {showText && (
        <div className={`font-black tracking-tight text-white font-display ${textSize} flex items-baseline`}>
          KAIZEN<span className={`text-emerald-500 leading-none ${dotSize}`}>.</span>
        </div>
      )}
    </div>
  );
};

import React, { useState } from 'react';
import { useAuth } from '../../context/AuthContext';
import {
  Dumbbell, Flame, User, LogOut, FileText, Activity,
  ChevronDown, Menu, X, Calculator, Calendar, CheckSquare
} from 'lucide-react';
import { KaizenLogo } from './KaizenLogo';

export const Navbar = ({ currentView, setCurrentView, onSelectTrack, selectedTrack, extraNavItems = [] }) => {
  const { user, logout, openAuth } = useAuth();
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [userDropdownOpen, setUserDropdownOpen] = useState(false);

  const navItems = [
    { id: 'landing', label: 'Home' },
    { id: 'tracks', label: 'Choose Track' },
    { id: 'curriculum', label: 'Courses' },
    { id: 'tracker', label: '💪 Workout Log' },
    { id: 'nutrition', label: '🍽️ Nutrition' },
    { id: 'program', label: '📅 12-Week Plan' },
    { id: 'checklist', label: '✅ Checklist' },
    { id: 'resources', label: '📄 PDF Library' },
  ];

  return (
    <nav className="sticky top-0 z-40 bg-slate-950/90 backdrop-blur-xl border-b border-slate-800/80">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex items-center justify-between h-16">

          {/* Brand */}
          <button onClick={() => setCurrentView('landing')} className="flex items-center gap-2.5 group hover:opacity-80 transition-opacity">
            <KaizenLogo />
          </button>

          {/* Desktop Nav */}
          <div className="hidden xl:flex items-center gap-0.5">
            {navItems.map((item) => (
              <button
                key={item.id}
                onClick={() => setCurrentView(item.id)}
                className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all whitespace-nowrap ${
                  currentView === item.id
                    ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20'
                    : 'text-slate-400 hover:text-white hover:bg-slate-900'
                }`}
              >
                {item.label}
              </button>
            ))}
          </div>

          {/* Right: Auth */}
          <div className="hidden md:flex items-center gap-2">
            {user ? (
              <div className="relative">
                <button
                  onClick={() => setUserDropdownOpen(!userDropdownOpen)}
                  className="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-all"
                >
                  <img src={user.avatar} alt={user.name} className="w-7 h-7 rounded-full ring-2 ring-emerald-500/40 object-cover" />
                  <div className="text-left">
                    <div className="text-xs font-semibold text-white">{user.name.split(' ')[0]}</div>
                    <div className="text-[10px] text-slate-400 flex items-center gap-1">
                      <Flame className="w-3 h-3 text-amber-400" />{user.currentStreak}d streak
                    </div>
                  </div>
                  <ChevronDown className="w-3.5 h-3.5 text-slate-400" />
                </button>
                {userDropdownOpen && (
                  <div className="absolute right-0 mt-2 w-52 rounded-xl bg-slate-900 border border-slate-800 shadow-2xl py-2 z-50"
                    onMouseLeave={() => setUserDropdownOpen(false)}>
                    <div className="px-4 py-2 border-b border-slate-800 text-xs text-slate-400 truncate">{user.email}</div>
                    {[
                      { id: 'dashboard', icon: User, label: 'My Dashboard', color: 'text-emerald-400' },
                      { id: 'tracker', icon: Activity, label: 'Workout Log', color: 'text-cyan-400' },
                      { id: 'nutrition', icon: Calculator, label: 'Nutrition Calc', color: 'text-amber-400' },
                      { id: 'program', icon: Calendar, label: '12-Week Program', color: 'text-purple-400' },
                      { id: 'checklist', icon: CheckSquare, label: 'Weekly Checklist', color: 'text-rose-400' },
                      { id: 'resources', icon: FileText, label: 'PDF Library', color: 'text-slate-400' },
                    ].map(({ id, icon: Icon, label, color }) => (
                      <button key={id} onClick={() => { setCurrentView(id); setUserDropdownOpen(false); }}
                        className="w-full text-left px-4 py-2 text-xs text-slate-300 hover:bg-slate-800 flex items-center gap-2 transition-colors">
                        <Icon className={`w-3.5 h-3.5 ${color}`} />{label}
                      </button>
                    ))}
                    <div className="border-t border-slate-800 mt-1 pt-1">
                      <button onClick={() => { logout(); setUserDropdownOpen(false); }}
                        className="w-full text-left px-4 py-2 text-xs text-rose-400 hover:bg-rose-500/10 flex items-center gap-2 transition-colors">
                        <LogOut className="w-3.5 h-3.5" />Log Out
                      </button>
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <div className="flex items-center gap-2">
                <button onClick={() => openAuth('login')} className="px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white transition-colors">
                  Log In
                </button>
                <button onClick={() => openAuth('signup')}
                  className="px-4 py-2 text-xs font-bold text-slate-950 bg-emerald-500 hover:bg-emerald-400 rounded-lg shadow-lg shadow-emerald-500/20 transition-all">
                  Join Free
                </button>
              </div>
            )}
          </div>

          {/* Mobile Toggle */}
          <button onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
            className="xl:hidden p-2 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
            {mobileMenuOpen ? <X className="w-5 h-5" /> : <Menu className="w-5 h-5" />}
          </button>
        </div>
      </div>

      {/* Mobile Menu */}
      {mobileMenuOpen && (
        <div className="xl:hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 space-y-1">
          {navItems.map((item) => (
            <button key={item.id} onClick={() => { setCurrentView(item.id); setMobileMenuOpen(false); }}
              className={`w-full text-left px-4 py-2.5 rounded-lg text-sm font-medium ${
                currentView === item.id ? 'bg-slate-900 text-emerald-400' : 'text-slate-300'
              }`}>
              {item.label}
            </button>
          ))}
          <div className="pt-3 border-t border-slate-800">
            {user ? (
              <>
                <button onClick={() => { setCurrentView('dashboard'); setMobileMenuOpen(false); }}
                  className="w-full text-left px-4 py-2.5 rounded-lg text-sm font-semibold text-emerald-400 bg-emerald-500/10">
                  My Dashboard ({user.name})
                </button>
                <button onClick={() => { logout(); setMobileMenuOpen(false); }}
                  className="w-full text-left px-4 py-2 mt-1 text-sm text-rose-400">
                  Log Out
                </button>
              </>
            ) : (
              <div className="grid grid-cols-2 gap-2 mt-2">
                <button onClick={() => { openAuth('login'); setMobileMenuOpen(false); }}
                  className="py-2.5 text-center rounded-xl bg-slate-900 border border-slate-800 text-white text-sm font-medium">
                  Log In
                </button>
                <button onClick={() => { openAuth('signup'); setMobileMenuOpen(false); }}
                  className="py-2.5 text-center rounded-xl bg-emerald-500 text-slate-950 text-sm font-bold">
                  Join Free
                </button>
              </div>
            )}
          </div>
        </div>
      )}
    </nav>
  );
};

import React, { useState, useEffect } from 'react';
import { useAuth } from '../../context/AuthContext';
import {
  ArrowLeft, ChevronRight, ChevronDown, CheckCircle, Circle,
  FileText, Download, BookOpen, ExternalLink, Award,
  Dumbbell, Layers, CheckSquare, Sparkles, Printer,
  ClipboardList, Trophy, Lock, AlertCircle
} from 'lucide-react';
import { QuizEngine } from './QuizEngine';
import { DOWNLOADABLE_PDFS } from '../../data/downloadablePdfs';
import { LessonContentRenderer } from './LessonContentRenderer';
import { PowerliftingProgramSelector } from './PowerliftingProgramSelector';

const TRACK_COLORS = {
  build: { text: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30', btn: 'bg-emerald-500 hover:bg-emerald-400 text-slate-950', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
  cut: { text: 'text-cyan-400', bg: 'bg-cyan-500/10', border: 'border-cyan-500/30', btn: 'bg-cyan-500 hover:bg-cyan-400 text-slate-950', badge: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20' },
  gain: { text: 'text-amber-400', bg: 'bg-amber-500/10', border: 'border-amber-500/30', btn: 'bg-amber-500 hover:bg-amber-400 text-slate-950', badge: 'bg-amber-500/10 text-amber-400 border-amber-500/20' },
  powerlifting: { text: 'text-purple-400', bg: 'bg-purple-500/10', border: 'border-purple-500/30', btn: 'bg-purple-500 hover:bg-purple-400 text-slate-950', badge: 'bg-purple-500/10 text-purple-400 border-purple-500/20' },
  bundle: { text: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30', btn: 'bg-emerald-500 hover:bg-emerald-400 text-slate-950', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
};

export const ClassroomPlayer = ({ course, initialLesson, onBack, onBuy }) => {
  const { user, isEnrolled, toggleLessonCompletion, isLessonCompleted, recordQuizResult } = useAuth();
  const enrolled = isEnrolled(course?.id) || isEnrolled('course-bundle-all');

  // flatten all lessons with module context
  const allLessons = course?.modules?.flatMap(m =>
    m.lessons.map(l => ({
      ...l,
      moduleId: m.id,
      moduleTitle: m.title,
      learningObjective: m.learningObjective,
      checkpoint: m.checkpoint,
      completionRequirement: m.completionRequirement,
    }))
  ) || [];

  const firstLesson = initialLesson || allLessons[0];
  const [activeLesson, setActiveLesson] = useState(firstLesson);
  const [activeTab, setActiveTab] = useState(firstLesson?.isQuiz ? 'quiz' : 'lesson');

  const [closedModules, setClosedModules] = useState({});
  const isModuleOpen = (mIdx) => !closedModules[mIdx];
  const toggleModule = (mIdx) => {
    setClosedModules(prev => ({ ...prev, [mIdx]: !prev[mIdx] }));
  };

  useEffect(() => {
    if (initialLesson) {
      const match = allLessons.find(l => l.id === initialLesson.id) || initialLesson;
      setActiveLesson(match);
      if (match.isQuiz) {
        setActiveTab('quiz');
      } else {
        setActiveTab('lesson');
      }
    } else if (allLessons.length > 0) {
      setActiveLesson(allLessons[0]);
      setActiveTab(allLessons[0].isQuiz ? 'quiz' : 'lesson');
    }
  }, [initialLesson, course?.id]);

  const colors = TRACK_COLORS[course?.trackId] || TRACK_COLORS.build;
  const coursePdf = DOWNLOADABLE_PDFS.find(p => p.trackId === course?.trackId) || DOWNLOADABLE_PDFS[0];
  const pdfUrl = coursePdf?.fileUrl || '/pdfs/KFA_12_Week_Workout_Plans.pdf';

  const handleLessonSelect = (lesson) => {
    if (!lesson.isFreePreview && !enrolled) {
      if (onBuy) onBuy(course);
      return;
    }
    const enriched = allLessons.find(l => l.id === lesson.id) || lesson;
    setActiveLesson(enriched);
    if (enriched.isQuiz) {
      setActiveTab('quiz');
    } else {
      setActiveTab('lesson');
    }
  };

  const handleMarkComplete = () => {
    if (activeLesson) toggleLessonCompletion(activeLesson.id);
  };

  const completed = activeLesson ? isLessonCompleted(activeLesson.id) : false;

  const handleDownloadPdf = () => {
    const a = document.createElement('a');
    a.href = pdfUrl;
    a.download = (coursePdf?.title || 'Kaizen_Workout_Plan').replace(/[^a-zA-Z0-9]/g, '_') + '.pdf';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  };

  const currentIdx = allLessons.findIndex(l => l.id === activeLesson?.id);
  const nextLesson = allLessons[currentIdx + 1] || null;

  return (
    <div className="min-h-screen bg-slate-950 flex flex-col">
      {/* Top Navigation Bar */}
      <div className="sticky top-0 z-30 bg-slate-950/95 backdrop-blur-md border-b border-slate-800 px-4 py-3 flex items-center justify-between gap-4">
        <div className="flex items-center gap-3 min-w-0">
          <button
            onClick={onBack}
            className="flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition-colors bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 flex-shrink-0"
          >
            <ArrowLeft className="w-4 h-4" /> Back to Course
          </button>
          <div className="text-xs text-slate-300 font-bold truncate hidden sm:block">
            {course?.title}
          </div>
        </div>

        <div className="flex items-center gap-2 flex-shrink-0">
          <button
            onClick={handleDownloadPdf}
            className="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all shadow-md shadow-emerald-500/20"
          >
            <Download className="w-3.5 h-3.5" /> Download Blueprint PDF
          </button>
          <a
            href={pdfUrl}
            target="_blank"
            rel="noreferrer"
            className="hidden md:flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-700 text-slate-300 hover:text-white transition-colors"
          >
            <ExternalLink className="w-3.5 h-3.5" /> Popout
          </a>
          <button
            onClick={handleMarkComplete}
            className={`flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg transition-all ${
              completed
                ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                : 'bg-slate-900 border border-slate-700 text-slate-300 hover:text-white'
            }`}
          >
            {completed ? <CheckCircle className="w-3.5 h-3.5 text-emerald-400" /> : <Circle className="w-3.5 h-3.5" />}
            {completed ? 'Completed' : 'Mark Done'}
          </button>
        </div>
      </div>

      <div className="flex-1 flex flex-col lg:flex-row overflow-hidden">
        {/* ── MAIN CONTENT AREA ── */}
        <div className="flex-1 flex flex-col overflow-y-auto">
          {/* Header Banner */}
          <div className="p-6 bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border-b border-slate-800">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <div className="flex items-center gap-2 mb-2">
                  <span className={`px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${colors.bg} ${colors.text} border ${colors.border}`}>
                    📑 Official Curriculum Lesson
                  </span>
                  <span className="text-xs text-slate-500">·</span>
                  <span className="text-xs text-slate-400">{activeLesson?.moduleTitle}</span>
                </div>
                <h1 className="text-2xl sm:text-3xl font-black text-white font-display">
                  {activeLesson?.title}
                </h1>
                <p className="text-sm text-slate-400 mt-1 max-w-2xl leading-relaxed">
                  {activeLesson?.summary || course?.subtitle}
                </p>
              </div>

              {activeLesson?.quizData && (
                <button
                  onClick={() => setActiveTab('quiz')}
                  className="px-4 py-2.5 bg-amber-500/10 border border-amber-500/30 text-amber-400 rounded-xl text-xs font-bold hover:bg-amber-500/20 transition-all flex items-center gap-2 flex-shrink-0"
                >
                  <Award className="w-4 h-4 text-amber-400" /> Take Lesson Quiz (5 Qs)
                </button>
              )}
            </div>

            {/* Module Checkpoint Pill if available */}
            {activeLesson?.checkpoint && (
              <div className="mt-4 p-3 rounded-xl bg-slate-950/80 border border-slate-800 text-xs text-slate-300 flex items-start gap-2.5 max-w-3xl">
                <ClipboardList className={`w-4 h-4 mt-0.5 flex-shrink-0 ${colors.text}`} />
                <div>
                  <span className="font-bold text-white uppercase text-[10px] tracking-wider block">
                    Module Checkpoint Target:
                  </span>
                  <span>{activeLesson.checkpoint}</span>
                </div>
              </div>
            )}

            {/* Content Tabs */}
            <div className="flex flex-wrap gap-2 mt-6">
              {[
                { id: 'lesson', icon: BookOpen, label: 'Educational Lesson Guide' },
                { id: 'pdf', icon: FileText, label: 'Official 12-Week PDF' },
                { id: 'routine', icon: Dumbbell, label: 'Routine & Exercise Menu' },
                { id: 'quiz', icon: Award, label: activeLesson?.isQuiz ? 'Final Certification Exam' : 'Lesson Quiz' },
                ...(course?.trackId === 'powerlifting' ? [{ id: 'powerlifting', icon: Trophy, label: 'Powerlifting Programs' }] : [])
              ].map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all border ${
                    activeTab === tab.id
                      ? 'bg-slate-800 text-white border-slate-700 shadow-md'
                      : 'bg-slate-950 text-slate-400 border-slate-800 hover:text-white'
                  }`}
                >
                  <tab.icon className={`w-3.5 h-3.5 ${activeTab === tab.id ? colors.text : ''}`} />
                  {tab.label}
                </button>
              ))}
            </div>
          </div>

          {/* Tab Panes */}
          <div className="p-6 flex-1">
            {/* 1. LESSON READING TAB (Full Educational Content) */}
            {activeTab === 'lesson' && (
              <div>
                <LessonContentRenderer
                  content={activeLesson?.content}
                  lesson={activeLesson}
                  color={course?.trackId}
                />

                {/* Bottom Navigation */}
                <div className="pt-8 border-t border-slate-800 flex items-center justify-between gap-4 max-w-4xl mx-auto">
                  <button
                    onClick={handleMarkComplete}
                    className={`flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs transition-all ${
                      completed
                        ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                        : 'bg-slate-900 border border-slate-700 text-white hover:border-emerald-500'
                    }`}
                  >
                    <CheckCircle className="w-4 h-4" />
                    {completed ? 'Lesson Completed ✓' : 'Mark Lesson as Complete'}
                  </button>

                  {nextLesson && (
                    <button
                      onClick={() => handleLessonSelect(nextLesson)}
                      className="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs bg-emerald-500 hover:bg-emerald-400 text-slate-950 transition-all shadow-md shadow-emerald-500/20"
                    >
                      <span>Next: {nextLesson.title.substring(0, 24)}...</span>
                      <ChevronRight className="w-4 h-4" />
                    </button>
                  )}
                </div>
              </div>
            )}

            {/* 2. PDF VIEWER TAB */}
            {activeTab === 'pdf' && (
              <div className="space-y-4">
                <div className="flex items-center justify-between p-4 rounded-xl bg-slate-900 border border-slate-800">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-black text-sm">
                      PDF
                    </div>
                    <div>
                      <div className="text-sm font-bold text-white">{coursePdf?.title}</div>
                      <div className="text-xs text-slate-400">{coursePdf?.pages} Pages · High-Resolution Printable Blueprint</div>
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <button
                      onClick={handleDownloadPdf}
                      className="px-3 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-lg text-xs flex items-center gap-1.5 transition-all"
                    >
                      <Download className="w-3.5 h-3.5" /> Download
                    </button>
                    <a
                      href={pdfUrl}
                      target="_blank"
                      rel="noreferrer"
                      className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-lg text-xs flex items-center gap-1.5 transition-colors"
                    >
                      <ExternalLink className="w-3.5 h-3.5" /> Popout
                    </a>
                  </div>
                </div>

                {/* Embedded PDF Viewer */}
                <div className="w-full h-[650px] rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 shadow-2xl relative">
                  <iframe
                    src={`${pdfUrl}#view=FitH`}
                    title="Kaizen 12-Week Workout Plan"
                    className="w-full h-full border-0"
                  />
                </div>
              </div>
            )}

            {/* 3. ROUTINE & COACHING CUES TAB */}
            {activeTab === 'routine' && (
              <div className="max-w-4xl space-y-6">
                <div className="p-5 rounded-2xl bg-slate-900 border border-slate-800">
                  <h3 className="text-base font-black text-white font-display mb-1 flex items-center gap-2">
                    <Dumbbell className="w-5 h-5 text-emerald-400" />
                    Recommended Weekly Split & Exercise Menu
                  </h3>
                  <p className="text-xs text-slate-400 mb-4">
                    Extracted directly from the Kaizen 12-Week Program. Follow the exact order and respect the target Reps In Reserve (RIR).
                  </p>

                  <div className="space-y-4">
                    {coursePdf?.previewSections ? (
                      coursePdf.previewSections.map((sec, idx) => (
                        <div key={idx} className="p-4 rounded-xl bg-slate-950 border border-slate-800/80">
                          <div className="text-xs font-black text-white uppercase tracking-wider mb-1 flex items-center gap-2">
                            <span className="w-2 h-2 rounded-full bg-emerald-400"></span>
                            {sec.title}
                          </div>
                          <div className="text-sm text-slate-300 leading-relaxed font-mono text-xs sm:text-sm">
                            {sec.text}
                          </div>
                        </div>
                      ))
                    ) : (
                      <p className="text-sm text-slate-400">Please refer to the PDF view for the complete exercise roster.</p>
                    )}
                  </div>
                </div>
              </div>
            )}

            {/* 4. QUIZ TAB */}
            {activeTab === 'quiz' && (
              <div className="max-w-2xl mx-auto py-4">
                {activeLesson?.quizData ? (
                  <QuizEngine
                    quizData={activeLesson.quizData}
                    courseId={course.id}
                    onComplete={(score, passed) => {
                      recordQuizResult(course.id, score, passed);
                      if (passed) {
                        toggleLessonCompletion(activeLesson.id);
                      }
                    }}
                  />
                ) : (
                  <div className="p-8 text-center text-slate-400">
                    <Award className="w-8 h-8 mx-auto mb-2 opacity-50" />
                    <p>No quiz registered for this chapter.</p>
                  </div>
                )}
              </div>
            )}

            {/* 5. POWERLIFTING PROGRAMS TAB */}
            {activeTab === 'powerlifting' && (
              <div className="max-w-3xl mx-auto py-4">
                <PowerliftingProgramSelector mode="dashboard" />
              </div>
            )}
          </div>
        </div>

        {/* ── SIDEBAR: Curriculum & Routine Chapters ── */}
        <div className="w-full lg:w-88 border-t lg:border-t-0 lg:border-l border-slate-800 bg-slate-900 flex flex-col">
          <div className="p-4 border-b border-slate-800">
            <div className="text-xs font-bold text-white uppercase tracking-wider flex items-center justify-between">
              <span>Course Curriculum</span>
              <span className="text-[11px] text-emerald-400 font-mono">
                {allLessons.filter(l => isLessonCompleted(l.id)).length}/{allLessons.length} Done
              </span>
            </div>
            
            {/* Progress bar */}
            <div className="mt-2.5 h-1.5 bg-slate-800 rounded-full overflow-hidden">
              <div
                className="h-full bg-emerald-500 rounded-full transition-all"
                style={{ width: `${allLessons.length > 0 ? (allLessons.filter(l => isLessonCompleted(l.id)).length / allLessons.length) * 100 : 0}%` }}
              />
            </div>
          </div>

          <div className="flex-1 overflow-y-auto">
            {course?.modules?.map((mod, mIdx) => (
              <div key={mod.id} className="border-b border-slate-800/60">
                <div className="w-full px-4 py-2.5 bg-slate-950/80 hover:bg-slate-900 border-b border-slate-800/40 text-left transition-colors flex items-center justify-between cursor-pointer">
                  <div
                    onClick={() => {
                      if (closedModules[mIdx]) {
                        setClosedModules(prev => ({ ...prev, [mIdx]: false }));
                      }
                      if (mod.lessons?.[0]) {
                        handleLessonSelect(mod.lessons[0]);
                      }
                    }}
                    className="flex-1 flex items-center gap-2 min-w-0 pr-2 cursor-pointer"
                  >
                    <span className="text-[11px] font-bold text-slate-200 uppercase tracking-wider truncate hover:text-emerald-400 transition-colors">
                      {mod.title}
                    </span>
                  </div>
                  <div className="flex items-center gap-2 flex-shrink-0">
                    <span className="text-[10px] text-slate-500 font-mono">
                      {mod.lessons.length}
                    </span>
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        toggleModule(mIdx);
                      }}
                      className="p-1 text-slate-400 hover:text-white cursor-pointer"
                      aria-label="Toggle module"
                    >
                      {isModuleOpen(mIdx) ? (
                        <ChevronDown className="w-3.5 h-3.5 text-emerald-400" />
                      ) : (
                        <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
                      )}
                    </button>
                  </div>
                </div>

                {isModuleOpen(mIdx) && (
                  <div>
                    {mod.lessons.map(lesson => {
                      const isActive = activeLesson?.id === lesson.id;
                      const isDone = isLessonCompleted(lesson.id);
                      const isLocked = !lesson.isFreePreview && !enrolled;
                      return (
                        <button
                          key={lesson.id}
                          onClick={() => handleLessonSelect(lesson)}
                          className={`w-full flex items-start gap-3 px-4 py-3 text-left transition-all cursor-pointer ${
                            isActive ? 'bg-emerald-500/10 border-l-2 border-emerald-500' : 'hover:bg-slate-800/50'
                          }`}
                        >
                          <div className={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 ${
                            isDone ? 'bg-emerald-500' : isLocked ? 'bg-slate-800 border border-slate-700' : 'border border-slate-700 bg-slate-800'
                          }`}>
                            {isDone ? (
                              <CheckCircle className="w-3 h-3 text-white" />
                            ) : isLocked ? (
                              <Lock className="w-2.5 h-2.5 text-slate-500" />
                            ) : (
                              <FileText className="w-2.5 h-2.5 text-slate-400" />
                            )}
                          </div>
                          <div className="flex-1 min-w-0">
                            <div className={`text-xs font-semibold leading-snug truncate ${
                              isActive ? colors.text : isLocked ? 'text-slate-400' : 'text-slate-300'
                            }`}>
                              {lesson.title}
                            </div>
                            <div className="text-[10px] text-slate-500 mt-0.5 flex items-center gap-2">
                              <span>{lesson.isQuiz ? 'Certification Exam' : 'Lesson & Quiz'}</span>
                              <span className="text-slate-600">·</span>
                              <span>{lesson.duration || '15 min'}</span>
                              {lesson.isFreePreview && <span className="text-emerald-400 font-bold ml-1">Free Preview</span>}
                              {isLocked && <span className="text-amber-400/90 font-semibold ml-1 flex items-center gap-0.5"><Lock className="w-2.5 h-2.5" /> Unlock</span>}
                            </div>
                          </div>
                        </button>
                      );
                    })}
                  </div>
                )}
              </div>
            ))}
          </div>

          {/* Quick PDF Action Card in Sidebar */}
          <div className="p-4 border-t border-slate-800 bg-slate-950 space-y-2">
            <button
              onClick={handleDownloadPdf}
              className="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2 border border-slate-700"
            >
              <Download className="w-4 h-4 text-emerald-400" />
              Download Full Blueprint PDF
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

import React, { useState } from 'react';
import { TRACKS, COURSES } from '../../data/coursesData';
import { useAuth } from '../../context/AuthContext';
import { Star, Clock, Users, Play, Lock, Dumbbell, Flame, Zap, Trophy, ArrowRight } from 'lucide-react';

const TRACK_ICONS = { build: Dumbbell, cut: Flame, gain: Zap, powerlifting: Trophy };
const TRACK_COLORS = {
  build:        { label: 'text-emerald-400', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30' },
  cut:          { label: 'text-cyan-400',    bg: 'bg-cyan-500/10',    border: 'border-cyan-500/30' },
  gain:         { label: 'text-amber-400',   bg: 'bg-amber-500/10',   border: 'border-amber-500/30' },
  powerlifting: { label: 'text-purple-400',  bg: 'bg-purple-500/10',  border: 'border-purple-500/30' },
};

export const CourseCatalog = ({ selectedTrackId, onSelectTrack, onViewCourse }) => {
  const { user, isEnrolled } = useAuth();
  const [filter, setFilter] = useState('all');

  const filteredCourses = filter === 'all' ? COURSES : COURSES.filter(c => c.trackId === filter);

  return (
    <div className="max-w-6xl mx-auto px-4 py-12">
      <div className="mb-8">
        <h1 className="text-3xl font-black text-white font-display mb-2">📚 All Training Programs</h1>
        <p className="text-slate-400">Browse every available course. Each includes the official 12-week workout plan PDF, tracker, nutrition calc, progression schedule & checklist.</p>
      </div>

      {/* Filter Tabs */}
      <div className="flex flex-wrap gap-2 mb-8">
        <button onClick={() => setFilter('all')}
          className={`px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${filter === 'all' ? 'bg-slate-700 text-white' : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'}`}>
          All Tracks
        </button>
        {TRACKS.map(t => {
          const Icon = TRACK_ICONS[t.id];
          const c = TRACK_COLORS[t.id];
          return (
            <button key={t.id} onClick={() => setFilter(t.id)}
              className={`flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${
                filter === t.id ? `${c.bg} ${c.label} border ${c.border}` : 'bg-slate-900 text-slate-400 hover:text-white border border-slate-800'
              }`}>
              <Icon className="w-4 h-4" />{t.id.toUpperCase()}
            </button>
          );
        })}
      </div>

      {/* Course Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        {filteredCourses.map(course => {
          const enrolled = isEnrolled(course.id);
          const color = TRACK_COLORS[course.trackId];
          const Icon = TRACK_ICONS[course.trackId];
          return (
            <div key={course.id} className="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition-all group">
              {/* Thumbnail */}
              <div className="relative h-48 overflow-hidden">
                <img src={course.thumbnail} alt={course.title} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div className="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent" />
                <div className="absolute top-3 left-3 flex gap-2">
                  {course.badge && (
                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded ${color.bg} ${color.label} border ${color.border}`}>
                      {course.badge}
                    </span>
                  )}
                  {enrolled && (
                    <span className="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500 text-slate-950">
                      ✓ ENROLLED
                    </span>
                  )}
                </div>
                <div className="absolute bottom-3 right-3 flex items-center gap-1 text-xs text-white bg-slate-950/70 px-2 py-1 rounded-lg">
                  <Clock className="w-3 h-3" />12-Week PDF · {course.lessonsCount} sections
                </div>
              </div>

              <div className="p-5">
                <div className={`flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider ${color.label} mb-2`}>
                  <Icon className="w-3.5 h-3.5" />{course.trackId} Track
                </div>
                <h3 className="text-base font-bold text-white mb-1 line-clamp-2 leading-snug">{course.title}</h3>
                <p className="text-xs text-slate-400 mb-3 line-clamp-2">{course.subtitle}</p>

                {/* Includes badges */}
                <div className="flex flex-wrap gap-1 mb-4">
                  {['📑 12-Week PDF', '🏋️ Routine Splits', '📊 Tracker', '🍽️ Nutrition', '📅 12-Week', '✅ Checklist'].map(tag => (
                    <span key={tag} className="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">{tag}</span>
                  ))}
                </div>

                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="flex items-center gap-1 text-xs">
                      <Star className="w-3.5 h-3.5 text-amber-400 fill-amber-400" />
                      <span className="font-bold text-white">{course.rating}</span>
                      <span className="text-slate-500">({course.reviewCount.toLocaleString()})</span>
                    </div>
                    <div className="flex items-center gap-1 text-xs text-slate-400">
                      <Users className="w-3 h-3" />{course.enrolledCount.toLocaleString()}
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <span className="text-lg font-black text-white">₹{course.discountPrice}</span>
                    <span className="text-xs text-slate-500 line-through">₹{course.price}</span>
